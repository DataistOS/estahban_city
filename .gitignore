# Miscellaneous
# Files generated by the OS or build tools.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Security
# Environment variables containing sensitive configuration.
.env
.tmp

# IntelliJ IDEA
# Configuration files for IntelliJ/Android Studio projects.
*.iml
*.ipr
*.iws
.idea/

# VS Code
# Commented out by default; keep uncommented if you wish to ignore user-specific settings.
# .vscode/

# Flutter/Dart/Pub
# Build output and auto-generated package configuration files.
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbols and Obfuscation
# Debug symbols and map files for release builds.
app.*.symbols
app.*.map.json

# Android
# Build artifacts specific to the Android build system.
/android/app/debug
/android/app/profile
/android/app/release
